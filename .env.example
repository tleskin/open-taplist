# Postgres connection string used by the app (and drizzle-kit migrate).
# Docker Compose builds this for you automatically; set it manually for
# local `next dev` or Vercel deploys.
# (If unset, the app falls back to POSTGRES_URL — handy when you attach a
# Vercel Postgres/Neon database with the POSTGRES env var prefix.)
DATABASE_URL=postgres://taplist:taplist@localhost:5432/taplist

# Shown in the tap list header. (Public: baked in at build time.)
NEXT_PUBLIC_BREWERY_NAME=My Home Brewery
